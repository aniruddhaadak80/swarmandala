{
  "name": "swarmandala",
  "version": "0.1.0",
  "private": true,
  "description": "A living atlas of Indian raga — hear the hour, see the scale.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev --filter=@repo/web",
    "build": "turbo run build",
    "start": "turbo run start --filter=@repo/web",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "loc": "bun scripts/loc-count.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.55.0",
    "turbo": "^2.5.6",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
