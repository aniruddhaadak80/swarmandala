# Swarmandala environment
#
# Every variable below is optional. A fresh clone runs with no .env file at all:
#
#   bun install
#   bun run dev
#
# Copy this file to .env.local only if you want to override a default. Next.js
# loads .env.local automatically and .gitignore keeps it out of git. There are
# no API keys to obtain: the tanpura is synthesised in the browser with Web
# Audio, and the atlas reads its ragas from packages/seed at build time.

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# Absolute origin used for canonical URLs, Open Graph tags, and the sitemap.
# Leave empty in development. Set it once in production, without a trailing
# slash:
#   NEXT_PUBLIC_SITE_URL=https://swarmandala.dev
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Optional parity service
# ---------------------------------------------------------------------------

# Base URL of the FastAPI service in services/rasa, used when the server-side
# parity check is enabled. Server-only: no NEXT_PUBLIC_ prefix, so it never
# reaches the browser bundle.
#   RASA_SERVICE_URL=http://127.0.0.1:8000
# Empty (the default) means ranking runs in-process through packages/core and
# nothing is fetched.
RASA_SERVICE_URL=

# ---------------------------------------------------------------------------
# Tooling (no effect on the app)
# ---------------------------------------------------------------------------

# Opt out of telemetry from Next.js and Turborepo. CI sets both to 1.
# NEXT_TELEMETRY_DISABLED=1
# TURBO_TELEMETRY_DISABLED=1
